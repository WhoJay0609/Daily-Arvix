# LLM API 配置
# 支持 OpenAI Compatible API（OpenRouter/DeepSeek/GLM/Ollama 等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-exp:free

# ArXiv 配置
# 多个分类用逗号分隔，如: cs.LG,cs.DC,cs.AI,cs.CL
ARXIV_CATEGORIES=cs.LG,cs.DC
ARXIV_MAX_RESULTS=50

# 兴趣关键词提示词文件路径
INTEREST_PROMPT_FILE=prompts/interest.txt

# 关键词预筛选（逗号分隔，空则不启用）
PREFILTER_KEYWORDS=
PREFILTER_NEGATIVE_KEYWORDS=

# 详细摘要数量（Top N）
TOP_N_DETAILED=5

# LLM 缓存（断点续跑）
LLM_CACHE_ENABLED=true
LLM_CACHE_FILE=.llm_cache.json

# 邮件配置（仅在 PUSH_CHANNEL=email/both 时需要）
# QQ 邮箱推荐使用 465 端口（SSL），Gmail 使用 587 端口（STARTTLS）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# 企业微信机器人 Webhook（HTTP 推送）
# 例: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECOM_WEBHOOK_URL=

# 推送方式: none（仅保存本地文件）、email / wecom / both
# 首次运行请保持 none；配置真实收件人或 Webhook 后再启用推送。
PUSH_CHANNEL=none

# 输出配置
OUTPUT_DIR=output

# 历史记录（避免重复处理）
HISTORY_FILE=.paper_history.txt
